{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push)",
      "Bash(git push -u origin:*)",
      "Bash(git merge:*)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git checkout main)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git config user.name:*)",
      "Bash(git config user.email:*)",
      "Bash(git clone:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git worktree list)",
      "Bash(git for-each-ref:*)",
      "Bash(git rev-list:*)",
      "Bash(git branch -r)",
      "Bash(gh repo view:*)",
      "Bash(gh repo create:*)",
      "Bash(gh pr:*)",
      "Bash(gh auth status)",
      "Bash(gh api user:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- :*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo archive:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git stash clear:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"; [ -f \"$f\" ] || f=\"$PWD/.claude/hooks/session_start.py\"; [ -f \"$f\" ] && python3 \"$f\" || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/context_check.py\"; [ -f \"$f\" ] || f=\"$PWD/.claude/hooks/context_check.py\"; [ -f \"$f\" ] && python3 \"$f\" || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_compact.py\"; [ -f \"$f\" ] || f=\"$PWD/.claude/hooks/pre_compact.py\"; [ -f \"$f\" ] && python3 \"$f\" || true"
          }
        ]
      }
    ]
  }
}
